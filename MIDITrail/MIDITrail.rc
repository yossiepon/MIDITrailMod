    LTEXT           "Width",IDC_STATIC,12,40,40,8
    EDITTEXT        IDC_EDIT_VE_WIDTH,56,38,56,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Height",IDC_STATIC,132,40,40,8
    EDITTEXT        IDC_EDIT_VE_HEIGHT,176,38,56,12,ES_AUTOHSCROLL | ES_NUMBER
