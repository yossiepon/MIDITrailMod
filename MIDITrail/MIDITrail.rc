    CONTROL         "",IDC_PICK_TRACK_R,"msctls_trackbar32",TBS_HORZ | TBS_NOTICKS | WS_TABSTOP,22,150,140,14
    EDITTEXT        IDC_PICK_EDIT_R,170,151,30,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "G",IDC_STATIC,10,170,8,8
