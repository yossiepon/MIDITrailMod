/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_MIDITRAIL           ICON                    "MIDITrail.ico"

IDI_SMALL               ICON                    "small.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_MIDITRAIL MENU
BEGIN
    POPUP "File"
    BEGIN
        MENUITEM "Open...\tCtrl + O",           IDM_OPEN_FILE
// >>> add 20120728 yossiepon begin
        MENUITEM "Add...\tCtrl + A",            IDM_ADD_FILE
// <<< add 20120728 yossiepon end
// >>> add ced 20260627: 1.4.1 folder playback / file navigation
        MENUITEM SEPARATOR
        MENUITEM "Open Folder...",              IDM_OPEN_FOLDER
        MENUITEM "Previous File",               IDM_PREVIOUS_FILE
        MENUITEM "Next File",                   IDM_NEXT_FILE
        MENUITEM "Folder Playback",             IDM_FOLDER_PLAYBACK
// <<< add ced 20260627
        MENUITEM SEPARATOR
        MENUITEM "Export Video...",             IDM_EXPORT_VIDEO
        MENUITEM SEPARATOR
        MENUITEM "Exit",                        IDM_EXIT
    END
    POPUP "Playback"
    BEGIN
        MENUITEM "Play / Pause\tSpace",         IDM_PLAY
        MENUITEM "Stop\tEsc",                   IDM_STOP
        MENUITEM "Repeat",                      IDM_REPEAT
        MENUITEM SEPARATOR
        MENUITEM "Skip Back\t1",                IDM_SKIP_BACK
        MENUITEM "Skip Forward\t2",             IDM_SKIP_FORWARD
        MENUITEM SEPARATOR
        MENUITEM "Speed Down\t4",               IDM_PLAY_SPEED_DOWN
        MENUITEM "Speed Up\t5",                 IDM_PLAY_SPEED_UP
        MENUITEM SEPARATOR
        MENUITEM "Start Monitoring\tShift + Space", IDM_START_MONITORING
        MENUITEM "Stop Monitoring\tEsc",        IDM_STOP_MONITORING
    END
    POPUP "View"
    BEGIN
        MENUITEM "Piano Roll 3D",               IDM_VIEW_3DPIANOROLL
        MENUITEM "Piano Roll 2D",               IDM_VIEW_2DPIANOROLL
        MENUITEM "Piano Roll Rain",             IDM_VIEW_PIANOROLLRAIN
        MENUITEM "Piano Roll Rain 2D",          IDM_VIEW_PIANOROLLRAIN2D
        MENUITEM "Piano Roll Ring",             IDM_VIEW_PIANOROLLRING
        MENUITEM SEPARATOR
        MENUITEM "Single Keyboard",             IDM_VIEW_SINGLEKEYBOARD
        MENUITEM "Piano Keyboard",              IDM_ENABLE_PIANOKEYBOARD
        MENUITEM "Ripple",                      IDM_ENABLE_RIPPLE
        MENUITEM "Lyrics",                      IDM_ENABLE_LYRICS
        MENUITEM "Pitch Bend Motion",           IDM_ENABLE_PITCHBEND
        MENUITEM "Pitch Bend Whole Channel",    IDM_ENABLE_PITCHBEND_ALLNOTES
        MENUITEM "Stars",                       IDM_ENABLE_STARS
        MENUITEM "Counter",                     IDM_ENABLE_COUNTER
        MENUITEM "Background Image",            IDM_ENABLE_BACKGROUNDIMAGE
// >>> add 20180404 yossiepon begin
        MENUITEM "Time Indicator",              IDM_ENABLE_TIMEINDICATOR
        MENUITEM "Grid Box",                    IDM_ENABLE_GRIDBOX
// <<< add 20180404 yossiepon end
        MENUITEM SEPARATOR
        MENUITEM "Viewpoint 1\t7",              IDM_RESET_VIEWPOINT
        MENUITEM "Viewpoint 2\t8",              IDM_VIEWPOINT2
        MENUITEM "Viewpoint 3\t9",              IDM_VIEWPOINT3
        MENUITEM SEPARATOR
        MENUITEM "Auto save viewpoint",         IDM_AUTO_SAVE_VIEWPOINT
// >>> add ced 20260628: persist View display toggles across restarts
        MENUITEM "Auto save view settings",     IDM_AUTO_SAVE_VIEWSETTINGS
// <<< add ced 20260628
// >>> add ced 20260627: 1.4.1 my viewpoint (3 slots)
        MENUITEM SEPARATOR
        MENUITEM "My Viewpoint 1",              IDM_MYVIEWPOINT1
        MENUITEM "My Viewpoint 2",              IDM_MYVIEWPOINT2
        MENUITEM "My Viewpoint 3",              IDM_MYVIEWPOINT3
        MENUITEM "Save My Viewpoint 1",         IDM_SAVE_MYVIEWPOINT1
        MENUITEM "Save My Viewpoint 2",         IDM_SAVE_MYVIEWPOINT2
        MENUITEM "Save My Viewpoint 3",         IDM_SAVE_MYVIEWPOINT3
// <<< add ced 20260627
        MENUITEM SEPARATOR
        MENUITEM "Window size...",              IDM_WINDOWSIZE
        MENUITEM "Full Screen\tF11",            IDM_FULLSCREEN
// >>> add ced 20260627: 1.4.1 menu bar toggle
        MENUITEM "Menu Bar",                    IDM_MENUBAR
// <<< add ced 20260627
    END
    POPUP "Option"
    BEGIN
        MENUITEM "MIDI OUT...",                 IDM_OPTION_MIDIOUT
        MENUITEM "MIDI IN...",                  IDM_OPTION_MIDIIN
        MENUITEM "Graphic...",                  IDM_OPTION_GRAPHIC
        MENUITEM "Color...",                    IDM_OPTION_COLOR
        MENUITEM "Config Manager...",           IDM_OPTION_CONFIGMANAGER
    END
    POPUP "Help"
    BEGIN
        MENUITEM "How to view...",              IDM_HOWTOVIEW
        MENUITEM "Manual...",                   IDM_MANUAL
        MENUITEM SEPARATOR
        MENUITEM "About...",                    IDM_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDC_MIDITRAIL ACCELERATORS
BEGIN
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
END


